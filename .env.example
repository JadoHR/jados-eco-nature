# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Database — SQLite file for local development.
# Production: a managed Postgres URL (and switch provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session cookies (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public base URL of the site (used for WhatsApp product links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# demo  = placeholder/demo products can be ordered (for testing), demo banner shown.
# live  = only products NOT marked demo/concept can be ordered. Use this at launch.
STORE_MODE="demo"

# Only used by `npm run admin:create` to create the first admin account.
# Remove them from the environment after use.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
